% Rules
is_directed_by(Movie, Director) :-
movie(Movie, _, Director, _).
is_genre(Movie, Genre) :-
movie(Movie, Genre, _, _).
released_in_year(Movie, Year) :-
movie(Movie, _, _, Year).
movies_by_director(Director, Movie) :-
movie(Movie, _, Director, _).
movies_in_genre(Genre, Movie) :-
movie(Movie, Genre, _, _).
movies_by_actor(Actor, Movie) :-
acted_in(Actor, Movie)